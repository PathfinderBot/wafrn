{
    email {$ACME_EMAIL}

    log {
        output stdout
        format console
    }
    metrics {
        per_host
    }

    admin 0.0.0.0:2019

    # Toggle HTTPS behavior via env
    {$AUTO_HTTPS_MODE}

    servers {
        trusted_proxies static 172.0.0.1/8
    }



    on_demand_tls {
        ask http://{$PDS_HOST:wafrn-pds-1:3000}/tls-check
    }
}

# -----------------------
# MEDIA (uploads)
# -----------------------
http://{$MEDIA_DOMAIN}, {$MEDIA_DOMAIN} {
    handle {
        root * /var/www/html/uploads/
        try_files {path} /index.html
        file_server
    }
}

# -----------------------
# CACHE (cdn)
# -----------------------
http://{$CACHE_DOMAIN}, {$CACHE_DOMAIN} {


    handle /api/cache* {
        reverse_proxy {$BACKEND_HOST:-backend:9000} {
            lb_policy least_conn
        }
    }

    handle /api/v2/cache/* {
        reverse_proxy {$BACKEND_HOST:-backend:9000} {
            lb_policy least_conn
        }
    }
}

# -----------------------
# MAIN FRONTEND
# -----------------------
http://{$DOMAIN_NAME}, {$DOMAIN_NAME} {



    encode zstd gzip

    header * {
        X-Clacks-Overhead "GNU Terry Pratchett"
        Service-Worker-Allowed: "/",
        Cache-Control: no-cache, must-revalidate
        Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' blob: data: https://{$CACHE_DOMAIN} https://{$MEDIA_DOMAIN} ; script-src 'self' 'unsafe-inline' 'unsafe-eval'; script-src-elem 'self' 'unsafe-inline' 'unsafe-eval'; script-src-attr 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' data: 'unsafe-inline'; style-src-elem 'self' data: 'unsafe-inline'; style-src-attr 'self' data: 'unsafe-inline'; object-src 'self' https://{$CACHE_DOMAIN} https://{$MEDIA_DOMAIN} ; frame-src 'self' https://{$CACHE_DOMAIN} https://{$MEDIA_DOMAIN}; worker-src 'self'; frame-ancestors 'self'; upgrade-insecure-requests; block-all-mixed-content; manifest-src 'self'"
    }

    @atPaths path_regexp at ^/@(.*)$
    redir @atPaths /fediverse/blog/{re.at.1} 301

    handle_path /api/websocket* {
        reverse_proxy {$WEBSOCKET_HOST:-backend:9000}
    }

    @api path /api* /fediverse* /contexts* /post* /blog* /.well-known*

    handle @api {
        reverse_proxy {$BACKEND_HOST:-backend:9000} {
            lb_policy least_conn
        }
    }

    handle_path /adminer* {
        reverse_proxy {$ADMINER_HOST:wafrn-adminer-1:8080}
    }

    handle / {
        reverse_proxy {$BACKEND_HOST:-backend:9000} {
            lb_policy least_conn
        }
    }

    handle {
        root * /var/www/html/frontend/
        try_files {path} /index.html
        file_server
    }
}

# -----------------------
# MONITORING
# -----------------------
http://{$MONITORING_DOMAIN}, {$MONITORING_DOMAIN} {
    reverse_proxy {$GRAFANA_HOST:wafrn-grafana-1:2345}
}

http://{$BULLBOARD_DOMAIN}, {$BULLBOARD_DOMAIN} {
    reverse_proxy {$BULLBOARD_HOST:bullboard:3000}
}

# -----------------------
# PDS (Bluesky / ATProto)
# -----------------------
http://{$PDS_DOMAIN_NAME}, http://*.{$PDS_DOMAIN_NAME}, {$PDS_DOMAIN_NAME}, *.{$PDS_DOMAIN_NAME} {

    tls {
        on_demand
    }

    handle /favicon.ico {
        root * /var/www/html/frontend/
        try_files {path} /favicon.ico
        file_server
    }

    handle / {
        root * /pds-homepage
        try_files {path} /pds.txt
        file_server
    }

    reverse_proxy {$PDS_HOST:wafrn-pds-1:3000}
}
