{
    email {$ACME_EMAIL}

    log {
        output stdout
        format console
    }
    metrics {
        per_host
    }

    admin 0.0.0.0:2019

    # Toggle HTTPS behavior via env
    {$AUTO_HTTPS_MODE:auto_https on}
    
    
    trusted_proxies 127.0.0.1
    
    
    on_demand_tls {
        ask http://{$PDS_HOST:wafrn-pds-1:3000}/tls-check
    }
}

# -----------------------
# MEDIA (uploads)
# -----------------------
http://{$MEDIA_DOMAIN}, {$MEDIA_DOMAIN} {
    handle {
        root * /var/www/html/uploads/
        try_files {path} /index.html
        file_server
    }
}

# -----------------------
# CACHE (cdn)
# -----------------------
http://{$CACHE_DOMAIN}, {$CACHE_DOMAIN} {

    handle /api/cache* {
        reverse_proxy {$BACKEND_HOST:-backend:9000} {
            lb_policy least_conn
        }
    }

    handle /api/v2/cache/* {
        reverse_proxy {$BACKEND_HOST:-backend:9000} {
            lb_policy least_conn
        }
    }
}

# -----------------------
# MAIN FRONTEND
# -----------------------
http://{$DOMAIN_NAME}, {$DOMAIN_NAME} {

    @atPaths path_regexp at ^/@(.*)$
    redir @atPaths /fediverse/blog/{re.at.1} 301

    handle_path /api/websocket* {
        reverse_proxy {$WEBSOCKET_HOST:-backend:9000}
    }

    @api path /api* /fediverse* /contexts* /post* /blog* /.well-known*

    handle @api {
        reverse_proxy {$BACKEND_HOST:-backend:9000} {
            lb_policy least_conn
        }
    }

    handle_path /adminer* {
        reverse_proxy {$ADMINER_HOST:-adminer:8080}
    }

    handle {
        root * /var/www/html/frontend/
        try_files {path} /index.html
        file_server
    }
}

# -----------------------
# MONITORING
# -----------------------
http://monitoring.{$DOMAIN_NAME}, monitoring.{$DOMAIN_NAME} {
    reverse_proxy {$GRAFANA_HOST:-grafana:2345}
}

http://bullboard.{$DOMAIN_NAME}, bullboard.{$DOMAIN_NAME} {
    reverse_proxy {$BULLBOARD_HOST:-bullboard:3000}
}

# -----------------------
# PDS (Bluesky / ATProto)
# -----------------------
http://{$PDS_DOMAIN_NAME}, http://*.{$PDS_DOMAIN_NAME}, {$PDS_DOMAIN_NAME}, *.{$PDS_DOMAIN_NAME} {

    tls {
        on_demand
    }

    handle /favicon.ico {
        root * /var/www/html/frontend/
        try_files {path} /favicon.ico
        file_server
    }

    handle / {
        root * /pds-homepage
        try_files {path} /pds.txt
        file_server
    }

    reverse_proxy {$PDS_HOST:wafrn-pds-1:3000}
}
